<component>
  <name>org.openkey.Linux</name>
  <description>OpenKey Vietnamese input method</description>
  <exec>@CMAKE_INSTALL_PREFIX@/bin/openkey-ibus</exec>
  <version>@PROJECT_VERSION@</version>
  <author>OpenKey contributors</author>
  <license>GPL-3.0-or-later</license>
  <engines>
    <engine>
      <name>openkey</name>
      <longname>Vietnamese - OpenKey</longname>
      <language>vi</language>
      <license>GPL-3.0-or-later</license>
      <author>OpenKey contributors</author>
      <icon>input-keyboard</icon>
      <layout>us</layout>
      <setup>@CMAKE_INSTALL_PREFIX@/bin/openkey-control</setup>
      <rank>90</rank>
    </engine>
  </engines>
</component>
